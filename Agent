Health-Gated Failover
Before calling a specific agent, verify it is active. If not, discover an alternative with the same tags.


async def call_with_failover(target: str, tags: list[str], **kwargs) -> dict:
    try:
        return await app.call(target, **kwargs)
    except Exception:
        # Find an active alternative
        fallback = app.discover(tags=tags, health_status="active")
        if not fallback.json.capabilities:
            raise RuntimeError(f"No active agents with tags {tags}")
        alt_cap = fallback.json.capabilities[0]
        alt_target = f"{alt_cap.agent_id}.{alt_cap.reasoners[0].id}"
        return await app.call(alt_target, **kwargs)