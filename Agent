@app.reasoner()
async def chat(message: str) -> dict:
    # Inject session memory and actor memory into the AI call
    response = await app.ai(
        system="You are a helpful assistant. Use the provided context.",
        user=message,
        memory_scope=["session", "actor"],  # auto-fetches and injects memory
    )
    return {"response": response}
