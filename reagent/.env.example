# AgentField Configuration
AGENTFIELD_CONTROL_PLANE_URL=http://localhost:8080
AGENT_NODE_ID=reagent
PORT=8001

# AI Model Configuration
AI_PROVIDER=qwen
AI_MODEL=qwen2.5-72b-instruct
AI_API_KEY=your_api_key_here
AI_FALLBACK_MODELS=anthropic/claude-sonnet-4,openai/gpt-4o
AI_ENABLE_RATE_LIMIT_RETRY=true
AI_RATE_LIMIT_MAX_RETRIES=5
AI_TIMEOUT=600

# GitLab Configuration
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_PROJECT_ID=your_project_id

# Bright Data Configuration (for web scraping and market intelligence)
# Get credits at: https://get.brightdata.com/aibuilders10
BRIGHTDATA_API_TOKEN=your_brightdata_token_here
BRIGHTDATA_ZONE=your_zone_name
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=22225

# Optional: Alternative AI Providers
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_DEFAULT_MODEL=poolside/laguna-m.1:free
QWEN_API_KEY=your_qwen_key
OPENAI_API_KEY=your_openai_key
